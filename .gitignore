/spikes/**/target/
/spikes/**/out/

# Machine-local configuration (signing identity, Team ID, host names)
*.local.toml
.env

# OS and editor files
.DS_Store
.idea/
.vscode/
*.swp
*~
/target/wp-notes/

# Machine-local Rimewire harness registrations (project board config stays tracked).
/.codex/config.toml
