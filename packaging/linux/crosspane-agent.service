# Installer payload template; WP-4.7b renders the complete quoted values.
[Unit]
Description=Crosspane agent (one keyboard and mouse, projected windows)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
StartLimitIntervalSec=120
StartLimitBurst=30

[Service]
ExecStart={{agent_executable}} run
Environment={{xdg_config_environment}}
Environment={{xdg_state_environment}}
Environment={{xdg_runtime_environment}}
Environment={{crosspane_runtime_environment}}
KillSignal=SIGTERM
TimeoutStopSec=10
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
