<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The agent reads the Crosspane speakers loopback (the hidden input of CrosspaneAudio.driver,
	     AUDIO-v0 / WP-3.5). macOS treats any audio input as the microphone: under the hardened
	     runtime that needs this entitlement plus NSMicrophoneUsageDescription, and the user's
	     Microphone permission. The agent never opens a physical microphone in v0. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
