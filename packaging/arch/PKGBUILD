# Arch / AUR package for Crosspane (05 "Packaging"). Builds the agent and crosspanectl from git
# and installs the systemd user unit. While the repository is private, build it locally:
#   cd packaging/arch && makepkg -si
pkgname=crosspane-git
pkgver=r0.0000000
pkgrel=1
pkgdesc="One keyboard and mouse, and projected windows, across your Mac, Hyprland, GNOME and KDE machines"
arch=('x86_64' 'aarch64')
url="https://github.com/frostdev-ops/crosspane"
license=('GPL-3.0-or-later')
depends=('dbus' 'ffmpeg' 'libxkbcommon' 'vulkan-icd-loader' 'wayland')
makedepends=('cargo' 'clang' 'git')
optdepends=('hyprland: a supported Linux desktop'
            'gnome-shell: a supported Linux desktop (enable the bundled Crosspane extension)'
            'xdg-desktop-portal-gnome: remote input, screen capture and input capture on GNOME'
            'plasma-desktop: a supported Linux desktop (portal backends)'
            'xdg-desktop-portal-kde: remote input and screen capture on KDE Plasma'
            'libei: emulated input through the portals'
            'waybar: shows the tray icon'
            'walker: menu for crosspanectl pick (or fuzzel, wofi, rofi)')
provides=('crosspane')
conflicts=('crosspane')
source=("crosspane::git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd crosspane
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd crosspane
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd crosspane
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p crosspane-agent -p crosspanectl -p crosspane-ui
}

check() {
  cd crosspane
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release -p crosspane-input -p crosspane-protocol -p crosspane-engine
}

package() {
  cd crosspane
  install -Dm755 target/release/crosspane-agent "$pkgdir/usr/bin/crosspane-agent"
  install -Dm755 target/release/crosspanectl "$pkgdir/usr/bin/crosspanectl"
  install -Dm755 target/release/crosspane-ui "$pkgdir/usr/bin/crosspane-ui"
  # The templates carry the installer's placeholders (WP-4.7b/c); render them for /usr.
  sed 's|{{settings_executable}}|/usr/bin/crosspane-ui|' \
    packaging/linux/crosspane-settings.desktop \
    | install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/crosspane-settings.desktop"
  sed 's|^Exec=crosspane-agent|Exec=/usr/bin/crosspane-agent|' \
    packaging/linux/io.frostdev.crosspane.agent.desktop \
    | install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/io.frostdev.crosspane.agent.desktop"
  sed -e 's|{{agent_executable}}|/usr/bin/crosspane-agent|' -e '/^Environment={{/d' \
    -e '/^# Installer payload template/d' packaging/linux/crosspane-agent.service \
    | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/crosspane-agent.service"
  # The GNOME Shell extension: every regular file in its directory (subdirectories are skipped).
  for f in packaging/gnome-shell-extension/crosspane@frostdev.io/*; do
    [ -f "$f" ] || continue
    install -Dm644 "$f" "$pkgdir/usr/share/gnome-shell/extensions/crosspane@frostdev.io/${f##*/}"
  done
  install -Dm644 docs/running.md "$pkgdir/usr/share/doc/crosspane/running.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
